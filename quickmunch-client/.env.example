# ==============================================================================
# QuickMunch Client — Environment Variables
# ==============================================================================

# Keycloak Identity Provider Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=quickmunch
VITE_KEYCLOAK_CLIENT_ID=quickmunch-client

# Backend API Gateway / Service Configuration
VITE_API_BASE_URL=http://localhost:8090
VITE_API_TIMEOUT_MS=15000

# Image Delivery CDN / AWS S3 Base URL
# Used to resolve stored object keys (e.g. restaurants/4/banner.jpg) to public URLs.
# For CloudFront CDN: https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
# For AWS S3: https://YOUR_BUCKET.s3.YOUR_REGION.amazonaws.com
# If left empty, object keys resolve to root-relative paths (e.g. /restaurants/...)
VITE_S3_BASE_URL=https://{YOUR_CLOUDFRONT_DOMAIN}.cloudfront.net
