# QuickMunch Client — Environment Configuration Template
# Copy this file to .env or .env.local to customize for your local or staging environment.

# Keycloak Identity Provider Configuration
# The base URL of the Keycloak server (no trailing slash, e.g. http://localhost:8080 or http://localhost:8180)
VITE_KEYCLOAK_URL=http://localhost:8080

# Keycloak Realm name
VITE_KEYCLOAK_REALM=quickmunch

# Keycloak Public Client ID (configured with Standard Flow ON, Client Auth OFF, PKCE S256)
VITE_KEYCLOAK_CLIENT_ID=quickmunch-client

# Backend Microservices / API Gateway Base URL
# Points to the API Gateway or directly to user-service in local development
VITE_API_BASE_URL=http://localhost:8090

# Request Timeout in Milliseconds (default: 15000)
VITE_API_TIMEOUT_MS=15000

